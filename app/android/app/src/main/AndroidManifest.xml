<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- Android 13+. Спрашивается не на первом запуске, а после первой гибели
         наёмника: тогда вопрос осмысленный (docs/02-TECH.md §3). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Уведомление о гибели переживает перезагрузку телефона: спуск идёт
         по часам, а не по работающему процессу. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- Рекламный идентификатор не собираем. Разрешение приходит СЛИЯНИЕМ из
         манифеста firebase-analytics, поэтому убрать его можно только так —
         тихо, без нашего участия оно оказалось бы в APK.

         Это не формальность. AD_ID в манифесте означает строку «рекламный
         идентификатор» в Play Data Safety, а с ней — обещание, которое игра
         не выполняет: она не показывает рекламы и не знает, кто её запустил.
         Аналитика видит игровое состояние (`docs/11-ANALYTICS.md` §5), и
         устройство в ней различается идентификатором установки Firebase,
         который умирает вместе с переустановкой. -->
    <uses-permission
        android:name="com.google.android.gms.permission.AD_ID"
        tools:node="remove" />
    <!-- Биометрия приезжает с firebase_auth (passkeys и подтверждение входа
         отпечатком). Игра знает ровно два входа — анонимный и Google, — и ни
         один из них отпечаток не спрашивает. А на странице Play «отпечаток
         пальца» у idle-RPG выглядит вопросом (docs/11-ANALYTICS.md §5).

         Снято перед первым релизом (docs/13-RELEASE.md §3.4). Проверять —
         входом через Google на живом телефоне: сломанный вход хуже лишней
         строки в списке разрешений. -->
    <uses-permission
        android:name="android.permission.USE_BIOMETRIC"
        tools:node="remove" />
    <uses-permission
        android:name="android.permission.USE_FINGERPRINT"
        tools:node="remove" />
    <!-- Имя бренда, а не переводимая строка: игра называется одинаково в
         магазине, в трейлере и на рабочем столе. Ярлык кириллицей был
         нечитаем для всех, кто не читает по-русски, — то есть для
         большинства тех, кому игра и показывается. -->
    <application
        android:label="Riftmark"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <!-- То же самое со стороны SDK: даже получив разрешение откуда-то
             ещё, Analytics не станет читать рекламный идентификатор. Два
             замка на одной двери — потому что первый снимается слиянием
             манифестов чужой библиотеки, а этот читается самим SDK. -->
        <meta-data
            android:name="google_analytics_adid_collection_enabled"
            android:value="false" />

        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />

        <!-- Приёмники плагина уведомлений. Объявляются ЗДЕСЬ, потому что с 19-й
             версии flutter_local_notifications их больше нет в манифесте самого
             плагина (там остались только разрешения) — а значит слияние
             манифестов их не добавит.

             Без первого будильник срабатывает в пустоту: система шлёт интент
             приёмнику, которого в приложении нет, и уведомление о гибели просто
             не появляется. Разрешение при этом выдано — снаружи это выглядит
             как «уведомления не приходят без причины».

             Второй переставляет будильники после перезагрузки телефона и после
             обновления приложения: спуск идёт по часам, а не по живому
             процессу, и наёмник может погибнуть, пока телефон выключен. -->
        <receiver
            android:name="com.dexterous.flutterlocalnotifications.ScheduledNotificationReceiver"
            android:exported="false" />
        <receiver
            android:name="com.dexterous.flutterlocalnotifications.ScheduledNotificationBootReceiver"
            android:exported="false" >
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
                <action android:name="com.htc.intent.action.QUICKBOOT_POWERON" />
            </intent-filter>
        </receiver>
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
