rules_version = '2';

// Правила доступа к облачному сейву. Источник правды — этот файл; в консоли
// Firebase они живут копией (Firestore Database → Rules → Publish), потому
// что проект не держит Firebase CLI ради одного файла. Правите здесь —
// публикуете там же, целиком, а не по строчке.
//
// База по умолчанию открыта на чтение и запись всем, у кого есть ключ из
// google-services.json, — то есть всем, кто скачал игру. Без этих правил
// чужой сейв можно и прочитать, и затереть.
//
// Что игра вообще пишет в облако (`app/lib/data/cloud_save_firestore.dart`):
//   players/{uid}/saves/{seasonId}
// и больше ничего. Всё остальное закрыто само: путь, не совпавший ни с одним
// `match`, запрещён по умолчанию — дописывать `allow: if false` не нужно.
service cloud.firestore {
  match /databases/{database}/documents {

    // Владелец — и только он. `request.auth.uid` приходит из проверенного
    // сервером токена Firebase Auth, подделать его на клиенте нельзя.
    // Анонимный вход тоже даёт uid, поэтому облако работает у всех, а не
    // только у тех, кто привязал Google.
    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    match /players/{uid}/saves/{seasonId} {

      // `get` — поднять свой сейв на новом телефоне.
      // `list` — обязательно: «Удалить аккаунт и данные» сначала читает
      // список сейвов всех сезонов, и без права на список удаление молча
      // не срабатывает.
      allow get, list: if isOwner(uid);

      // Удаление — целиком, включая сейвы прошлых сезонов: «удалить мои
      // данные» без них было бы неправдой.
      allow delete: if isOwner(uid);

      // Запись с проверкой формы. Тело сейва — строка JSON; всё, что не
      // строка, писать сюда незачем.
      //
      // Потолок 900 000 символов не про честного игрока: самый тяжёлый
      // сейв, который удалось собрать замером (400 вещей в сундуке,
      // постройки в максимум, глубина 400), весит 195 КБ — в четыре с
      // лишним раза меньше. Потолок про то, чтобы авторизованный клиент не
      // использовал базу как файлопомойку; свои 1 МиБ на документ Firestore
      // и так не отдаст.
      allow create, update: if isOwner(uid)
          && request.resource.data.payload is string
          && request.resource.data.payload.size() < 900000;
    }
  }
}
