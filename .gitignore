# Сборки и кэши — восстанавливаются одной командой, а весят гигабайты.
.dart_tool/
build/
app/build/
app/.dart_tool/
.packages
.flutter-plugins
.flutter-plugins-dependencies

# Собранные APK. Каждый под пятьдесят мегабайт; репозиторий — для исходников,
# готовые сборки раздаются релизами.
*.apk
*.aab

# Ключи проекта Firebase. Не секрет в криптографическом смысле — их видно в
# любом APK, — но и не то, что кладут в репозиторий: с чужим файлом сборка
# другого разработчика начинает писать в ЖИВОЙ поток аналитики, и отличить
# там игрока от отладки уже нечем. Как его получить — `docs/11-ANALYTICS.md` §2.
app/android/app/google-services.json
app/android/app/google-services.json.bak*

# Локальные пути SDK: у каждой машины свои.
app/android/local.properties
app/android/.gradle/
app/android/key.properties
*.keystore
*.jks

# Среда разработки.
.idea/
*.iml
.vscode/

# Мусор системы и прогонов.
.DS_Store
Thumbs.db
run.log
*.log
